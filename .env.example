# Somente servidor: nunca prefixar com VITE_.
TOPFIT_ADMIN_PASSWORD_HASH=
# PostgreSQL na Vercel (use a URL pooled fornecida pelo Neon, com SSL).
DATABASE_URL=
# Origem publica de producao exata. Em Preview utiliza VERCEL_URL automaticamente.
TOPFIT_SITE_URL=https://seu-dominio.example
# Somente desenvolvimento local SQLite, sem DATABASE_URL:
TOPFIT_DATA_DIR=.data
TOPFIT_BACKUP_DIR=backups
